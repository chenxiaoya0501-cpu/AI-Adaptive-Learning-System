DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning_system
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/learning_system
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads

# JWT（生产务必更换）
SECRET_KEY=dev-learning-system-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 开发种子学生账号（启动时若不存在则创建）
SEED_STUDENT_ACCOUNT=demo@local
SEED_STUDENT_PASSWORD=demo123
SEED_STUDENT_NICKNAME=演示学生

# LLM配置（也可通过管理界面配置）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
